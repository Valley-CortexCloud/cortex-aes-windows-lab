# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

aws_region = "us-east-1"
owner_tag  = "jvalley"

# --- OS edition ---
# "server2022" works on `apply` with zero extra steps and gives IDENTICAL Koi
# discovery behaviour. "windows11" needs a dedicated host + a BYOL Win11 AMI id
# (see docs/WINDOWS11_NOTES.md).
os_edition = "server2022"
# os_edition       = "windows11"
# windows11_ami_id = "ami-xxxxxxxxxxxxxxxxx"

# --- sizing ---
instance_type  = "t3.large"
root_volume_gb = 100

# --- access ---
# Your PUBLIC IP (see https://checkip.amazonaws.com). Bare IP or /32 both fine.
# Must be a public address - a private 192.168./10./172.16. IP won't reach the box.
# Leave empty to auto-detect your current public IP.
# allowed_rdp_cidr = "203.0.113.7"
allowed_rdp_cidr = ""

# Run base machine prep (Chocolatey, git) at boot.
auto_provision = true
